{
  "name": "tas-smart-city",
  "version": "1.0.0",
  "private": true,
  "description": "Test Automation Solution (TAS) do Projeto Integrador ResolveAi (Smart City) - ADS033 2026.2",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unidade": "node --test \"tests/unidade/**/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/**/*.test.js\"",
    "test:smoke": "node --test --test-concurrency=1 tests/e2e/e2e01-ciclo-de-vida-da-demanda.test.js tests/e2e/e2e02-triagem-e-rejeicao.test.js tests/e2e/e2e03-onboarding-do-cidadao.test.js",
    "test:app": "node scripts/executar-suite.js --nivel app --junit evidencias/app.xml tests/app/e2e13-notificacao-de-status.app.js",
    "test:backend-real": "node scripts/backend-real.js",
    "qualidade": "node scripts/backend-real.js --qualidade",
    "test:tudo": "node scripts/rodar-tudo.js",
    "test:relatorio": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=evidencias/resultado.xml \"tests/**/*.test.js\"",
    "verificar": "node scripts/verificar-cobertura.js && node scripts/verificar-politica.js",
    "manutencao": "node scripts/manutencao.js --simulacao --revisao",
    "metricas": "node scripts/metricas.js",
    "relatorios": "node scripts/relatorios.js",
    "issues": "node scripts/abrir-issues.js",
    "sut:referencia": "node sut-referencia/server.js",
    "diagnostico": "node lib/diagnostico.js",
    "sensibilidade": "node scripts/sensibilidade.js"
  },
  "license": "UNLICENSED"
}
