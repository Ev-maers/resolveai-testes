{
  "name": "tas-smart-city",
  "version": "1.0.0",
  "private": true,
  "description": "Test Automation Solution (TAS) de API para o SUT Smart City / ResolveAi - ADS033 2026.2",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:api": "node --test \"tests/api/**/*.test.js\"",
    "test:unidade": "node --test \"tests/unidade/**/*.test.js\"",
    "test:smoke": "node --test tests/e2e/e2e01-ciclo-de-vida-da-demanda.test.js tests/e2e/e2e02-triagem-e-rejeicao.test.js tests/e2e/e2e03-onboarding-do-cidadao.test.js",
    "test:relatorio": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=evidencias/resultado.xml \"tests/**/*.test.js\"",
    "test:tudo": "node scripts/rodar-tudo.js",
    "sut:referencia": "node sut-referencia/server.js",
    "diagnostico": "node lib/diagnostico.js",
    "sensibilidade": "node scripts/sensibilidade.js"
  },
  "license": "UNLICENSED"
}
